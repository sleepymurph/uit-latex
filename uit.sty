% Author: Mike Murphy <michael.j.murphy@uit.no>

% Colors are specified in both coated (bestrøket) and uncoated (ubestrøket)
% versions. My understanding is that this is for glossy vs matte paper.
% Coated (bestøket) is the default since it is listed first on the color card.
% To use the uncoated (ubestrøket) version of the color, use the option uncoated.
\newif\if@uit@coated\@uit@coatedtrue
\DeclareOption{uncoated}{\@uit@coatedfalse}

\ProcessOptions\relax

% This is for the grafiskprofil introduced in 2019 (see [Hva og hvorfor?]).
%
% [Hva og hvorfor?]: https://uit.no/ansatte/grafiskprofil#innhold_617372

% Colors
% ------------------------------------------------------------
%
% [UiTs fargepalett]: https://uit.no/ansatte/grafiskprofil#innhold_617372
% [Fargekombinasjoner]: https://uit.no/ansatte/grafiskprofil#innhold_631461

\RequirePackage{xcolor}

% Parameters: name, bestrøket, ubestrøket, RGB, HTML (order on the UiT web page)
\newcommand{\uit@definecolor}[5]{%
    % Explicitly set the lowercase 'rgb' definition from the 'RGB' definition.
    % Otherwise, xcolor will calculate it from the 'cmyk' definition
    % (because 'cmyk' is listed first) and come up with a different color.
    \convertcolorspec{RGB}{#4}{rgb}{\rgb}
    \definecolor{#1}{cmyk/RGB/HTML/rgb}{\if@uit@coated #2 \else #3 \fi / #4 / #5 / \rgb}
}

\uit@definecolor{UitDarkBlue}
    {0.94, 0.24, 0.00, 0.85}
    {1.00, 0.17, 0.00, 0.73}
    {0, 51, 73} {003349}

