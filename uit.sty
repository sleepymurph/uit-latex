\RequirePackage{xcolor}

% Parameters: name, bestrøket, ubestrøket, RGB, HTML (order on the UiT web page)
\newcommand{\uit@definecolor}[5]{%
    % Explicitly set the lowercase 'rgb' definition from the 'RGB' definition.
    % Otherwise, xcolor will calculate it from the 'cmyk' definition
    % (because 'cmyk' is listed first) and come up with a different color.
    \convertcolorspec{RGB}{#4}{rgb}{\rgb}
    \definecolor{#1}{cmyk/RGB/HTML/rgb}{\if@uit@coated #2 \else #3 \fi / #4 / #5 / \rgb}
}

\uit@definecolor{UitDarkBlue}
    {0.94, 0.24, 0.00, 0.85}
    {1.00, 0.17, 0.00, 0.73}
    {0, 51, 73} {003349}

\uit@definecolor{UitRed}
    {0.02, 0.97, 0.85, 0.07}
    {0.01, 0.87, 0.89, 0.04}
    {203, 51, 59} {CB333B}

\uit@definecolor{UitMedBlue}
    {0.98, 0.06, 0.10, 0.29}
    {0.99, 0.03, 0.16, 0.19}
    {0, 115, 150} {007396}

\uit@definecolor{UitLightBlue}
    {0.60, 0.00, 0.25, 0.00}
    {0.60, 0.00, 0.20, 0.00}
    {89, 190, 201} {59BEC9}

\uit@definecolor{UitYellow}
    {0.00, 0.32, 1.00, 0.00}
    {0.00, 0.31, 0.90, 0.00}
    {242, 169, 0} {F2A900}

\newcommand{\uitcolortest}{%
    \begin{testcolors}[cmyk,RGB,HTML]
        \testcolor{UitDarkBlue}
        \testcolor{UitRed}
        \testcolor{UitMedBlue}
        \testcolor{UitLightBlue}
        \testcolor{UitYellow}
    \end{testcolors}
}

% Presentation colors
% ------------------------------------------------------------
%
% The 2019 UiT PowerPoint template focuses entirely on the title page.
% There isn't a master slide for normal slides.
%
% For the title page:
%
% The right half is 003349, the UitDarkBlue color.
% The  left half is 004660, which is just a lightened version of that color.
%
% If we take that same step again we get 005971,
% then 007282, which is very close to the 007396 of the UitMedBlue color.
%
% So these four steps are perfect for a four-color Beamer palette.
%
% "By default, the palette colors do not have a background and the foreground
% ranges from structure.fg to black."

\colorlet{UitPptBgRight}{UitDarkBlue}
\definecolor{UitPptBgLeft}{HTML}{004660}

\if@uit@usecolortheme
\mode<presentation>
    \setbeamercolor*{alerted text}      {fg=UitRed}
    \setbeamercolor*{structure}         {fg=UitMedBlue!50!UitPptBgLeft}
    \setbeamercolor*{palette primary}   {fg=UitMedBlue}
    \setbeamercolor*{palette secondary} {fg=UitMedBlue!50!UitPptBgLeft}
    \setbeamercolor*{palette tertiary}  {fg=UitPptBgLeft}
    \setbeamercolor*{palette quaternary}{fg=UitDarkBlue}
    \setbeamercolor*{titlelike}         {parent=palette primary}
\mode<all>
\fi

\newcommand{\testclr}[1]{\fboxsep\z@\fcolorbox{black}{#1}{\phantom{XX}}}
\newcommand{\showclr}[2]{%
    \convertcolorspec{named}{#1}{#2}{\rgb}
}

\newcommand{\uitcolortestbeamerpalette}{%
    \newcommand{\beamertestcolor}[1]{%
        \usebeamercolor{##1}%
        {\fboxsep\z@\fcolorbox{black}{fg}{\phantom{XX}}}
        ##1 \testcolor{fg}%
    }%
    \newcommand{\testbeamercolor}[1]{%
        ##1 &
        \usebeamercolor{##1}\testclr{fg} \convertcolorspec{named}{fg}{HTML}\html \html &
        \usebeamercolor{##1}\testclr{bg} \convertcolorspec{named}{bg}{HTML}\html \html \\
    }%
    \begin{tabular}{lll}
        \bf color & \bf fg & \bf bg \\
        \testbeamercolor{normal text}
        \testbeamercolor{example text}
        \testbeamercolor{alerted text}
        \\
        \testbeamercolor{structure}
        \testbeamercolor{palette primary}
        \testbeamercolor{palette secondary}
        \testbeamercolor{palette tertiary}
        \testbeamercolor{palette quaternary}
    \end{tabular}
}

% Angled line / Skråelement
% ------------------------------------------------------------
%
% The angled line is described on the Skråelement page.
% They don't specify the angle but I know it refers to Tromsø's 69°40' latitude.
% I remember reading somewhere that it should be 70° and not 69°,
% but I can't find it now. I think it was on the old pages (2013 profile).
%
% I measured the PowerPoint background with Inkscape's measuring tool and
% got 67.6°.
%
% There do not appear to be any restrictions on the position of the line
% on the page, only that it must always lean to the right.
%
% [Skråelement]: https://uit.no/ansatte/grafiskprofil#innhold_631814
