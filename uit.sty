\RequirePackage{xcolor}

% Parameters: name, bestrøket, ubestrøket, RGB, HTML (order on the UiT web page)
\newcommand{\uit@definecolor}[5]{%
    % Note: It is important to list an RGB-based definition first in the
    % `\definecolor` declarations here. This is because xcolor takes the first
    % color model given as the default natural color model for this color. We
    % want that to default be the RGB version.
    %
    % If we put the CMYK definition first here, then xcolor will often end up
    % recalculating RGB values from the CMYK definition, which results in
    % something different than the explicit RGB definitions. In particular, the
    % lighter blues come out looking turquoise.
    %
    %\definecolor{#1}{cmyk/RGB/HTML}{\if@uit@coated#2\else#3\fi / #4 / #5}   % turquoise
    \definecolor{#1}{RGB/HTML/cmyk}{#4 / #5 / \if@uit@coated#2\else#3\fi}   % ok
}

