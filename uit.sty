% Link colors
% ------------------------------------------------------------

\colorlet{uitlinkcolor}{UitRed!70!black}
% This lightened UitDarkBlue is very close to the left side of the PowerPoint template
\colorlet{uiturlcolor}{white!20!UitDarkBlue}
\newcommand{\uitlinkcolors}{%
    \hypersetup{
        linkcolor=uitlinkcolor,
        citecolor=uitlinkcolor,
        urlcolor=uiturlcolor,
        filecolor=uitlinkcolor,
    }
}

% Color test helper
% ------------------------------------------------------------

\newcommand{\uitcolortest}[1][cmyk,RGB,HTML]{%
    \begin{testcolors}[#1]
        \testcolor{UitDarkBlue}
        \testcolor{UitRed}
        \testcolor{UitMedBlue}
        \testcolor{UitLightBlue}
        \testcolor{UitYellow}
    \end{testcolors}
}

% Beamer color test helper
% ------------------------------------------------------------

% Adapted from the xcolor source
\newcommand{\uit@testclr}[1]{\fboxsep\z@\fcolorbox{black}{#1}{\phantom{XX}}}

\newcommand{\uitcolortestbeamerpalette}{%
    \newcommand{\testbeamercolor}[1]{%
        ##1 &
        \usebeamercolor{##1}\uit@testclr{fg} \convertcolorspec{named}{fg}{HTML}\html \html &
        \usebeamercolor{##1}\uit@testclr{bg} \convertcolorspec{named}{bg}{HTML}\html \html &
        \usebeamercolor{##1}\fboxsep 1pt \colorbox{bg}{\textcolor{fg}{##1}} \\
    }%
    \begin{tabular}{llll}
        \bf color & \bf fg & \bf bg & \bf sample \\
        \testbeamercolor{normal text}
        \testbeamercolor{alerted text}
        \testbeamercolor{example text}
        \\
        \testbeamercolor{structure}
        \testbeamercolor{palette primary}
        \testbeamercolor{palette secondary}
        \testbeamercolor{palette tertiary}
        \testbeamercolor{palette quaternary}
        \\
        \testbeamercolor{block title}
        \testbeamercolor{block body}
        \testbeamercolor{block title alerted}
        \testbeamercolor{block body alerted}
        \testbeamercolor{block title example}
        \testbeamercolor{block body example}
    \end{tabular}
}

% Angled line / Skråelement
% ------------------------------------------------------------
%
% The angled line is described on the Skråelement page.
% They don't specify the angle but I know it refers to Tromsø's 69°40' latitude.
% I remember reading somewhere that it should be 70° and not 69°,
% but I can't find it now. I think it was on the old pages (2013 profile).
%
% I measured the PowerPoint background with Inkscape's measuring tool and
% got 67.6°.
%
% There do not appear to be any restrictions on the position of the line
% on the page, only that it must always lean to the right.
%
% [Skråelement]: https://uit.no/ansatte/grafiskprofil#innhold_631814
