\mode<presentation>

\RequirePackage{uit}

% Presentation colors
% ------------------------------------------------------------
%
% The 2019 UiT PowerPoint template focuses entirely on the title page.
% There isn't a master slide for normal slides.
%
% For the title page:
%
% The right half is 003349, the UitDarkBlue color.
% The  left half is 004660, which is just a lightened version of that color.
%
% If we take that same step again we get 005971,
% then 007282, which is very close to the 007396 of the UitMedBlue color.
%
% So these four steps are perfect for a four-color Beamer palette.
%
% "By default, the palette colors do not have a background and the foreground
% ranges from structure.fg to black."

\colorlet{UitPptBgRight}{UitDarkBlue}
\definecolor{UitPptBgLeft}{HTML}{004660}

% Outer colors: patterned after the 'whale' outer color theme
% ------------------------------------------------------------

\setbeamercolor*{alerted text}      {fg=UitRed}
\setbeamercolor*{example text}      {fg=UitYellow}

\setbeamercolor*{palette primary}   {fg=white, bg=UitMedBlue}
\setbeamercolor*{palette secondary} {fg=white, bg=UitMedBlue!66!UitDarkBlue}
\setbeamercolor*{palette tertiary}  {fg=white, bg=UitMedBlue!33!UitDarkBlue}
\setbeamercolor*{palette quaternary}{fg=white, bg=UitDarkBlue}

\setbeamercolor*{structure}         {fg=UitMedBlue}
%\setbeamercolor*{titlelike}         {parent=palette primary}

% For reference, the 'infolines' outer theme uses
%
% Header: | 3: section    | 1: subsection  |
%         +---------------+----------------+
%         |                                |
%         +-----------+----------+---------+
% Footer: | 3: author | 2: title | 1: date |
%
% In general, primary is for the things that change the most


% Inner colors: patterned after the 'orchid' outer color theme
% ------------------------------------------------------------

\setbeamercolor{block title}{parent=titlelike}

% From 'orchid': block bodies blend the respective title bg with the parent bg
\setbeamercolor{block body}
    {parent=normal text, use=block title,           bg=block title.bg!10!bg}
\setbeamercolor{block body alerted}
    {parent=normal text, use=block title alerted,   bg=block title alerted.bg!10!bg}
\setbeamercolor{block body example}
    {parent=normal text, use=block title example,   bg=block title example.bg!10!bg}

% And the 'orchid' color theme shades blocks
% by blending the 'structure' color with black


% Color test helper
% ------------------------------------------------------------

% Adapted from the xcolor source
\newcommand{\uit@testclr}[1]{\fboxsep\z@\fcolorbox{black}{#1}{\phantom{XX}}}

\newcommand{\uitcolortestbeamerpalette}{%
    \newcommand{\testbeamercolor}[1]{%
        ##1 &
        \usebeamercolor{##1}\uit@testclr{fg} \convertcolorspec{named}{fg}{HTML}\html \html &
        \usebeamercolor{##1}\uit@testclr{bg} \convertcolorspec{named}{bg}{HTML}\html \html &
        \usebeamercolor{##1}\fboxsep 1pt \colorbox{bg}{\textcolor{fg}{##1}} \\
    }%
    \begin{tabular}{llll}
        \bf color & \bf fg & \bf bg & \bf sample \\
        \testbeamercolor{normal text}
        \testbeamercolor{alerted text}
        \testbeamercolor{example text}
        \\
        \testbeamercolor{structure}
        \testbeamercolor{palette primary}
        \testbeamercolor{palette secondary}
        \testbeamercolor{palette tertiary}
        \testbeamercolor{palette quaternary}
        \\
        \testbeamercolor{block title}
        \testbeamercolor{block body}
        \testbeamercolor{block title alerted}
        \testbeamercolor{block body alerted}
        \testbeamercolor{block title example}
        \testbeamercolor{block body example}
    \end{tabular}
}

\mode<all>
